<?xml version="1.0"?>
<robot name="simple_lift" xmlns:xacro="http://www.ros.org/wiki/xacro">

  <link name="world"/>

  <joint name="base_joint" type="fixed">
    <parent link="world"/>
    <child link="base_link"/>
  </joint>

  <link name="base_link">
    <inertial>
      <mass value="50.0"/>
      <inertia ixx="1.0" ixy="0" ixz="0" iyy="1.0" iyz="0" izz="1.0"/>
    </inertial>
    <visual>
      <geometry><box size="0.2 0.2 10.0"/></geometry>
      <origin xyz="0 0 5.0" rpy="0 0 0"/> 
      <material name="grey"><color rgba="0.5 0.5 0.5 1"/></material>
    </visual>
    <collision>
      <geometry><box size="0.2 0.2 10.0"/></geometry>
      <origin xyz="0 0 5.0" rpy="0 0 0"/>
    </collision>
  </link>

  <!-- <link name="platform_link">
